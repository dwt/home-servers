#!/bin/bash

pv_args=(
    --progress
    --timer
    --eta
    --rate
    --average-rate
    --bytes
)

# check the disk
# diskutil list external physical

# note the disk name of the sd card
# set --local disk "/dev/disk4"
# read -p "Enter the disk identifier (e.g., /dev/disk4): " disk
# Disk name is printed last
disk=$(
    diskutil list physical |
        grep '^/dev/disk' |
        awk '{print $1}' |
        fzf --prompt="Select a disk: " --preview="diskutil list physical {}"
)
echo "$disk"

read -p "You have selected $disk. Is this correct? (Y/n): " confirm
if [[ $confirm != "y" ]] && [[ $confirm != "Y" ]] && [[ -n $confirm ]]; then
    echo "Exiting."
    exit 1
fi

# ensure it is umounted
diskutil unmountDisk "$disk"

# Write the image to the sd card
pv "${pv_args[@]}" nixos-sd.img | sudo dd of="$disk" bs=4m conv=fsync

# eject the disk
diskutil eject "$disk"
