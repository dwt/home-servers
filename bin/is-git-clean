#! /bin/sh

set -e

if [ -n "$(git status --porcelain)" ]; then
    echo "Error: Repository is not clean. There are uncommitted or untracked changes."
    exit 1
fi

if ! git rev-parse --verify "@{u}" >/dev/null 2>&1; then
    echo "Error: Current branch has no upstream configured."
    exit 1
fi

if [ -n "$(git rev-list "@{u}..HEAD")" ]; then
    echo "Error: There are local commits that have not been pushed to the server."
    exit 1
fi
