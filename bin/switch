#! /bin/sh

set -e

HERE=$(dirname "$0")

# If there are things that are not pushed to git, then auto update will eventually undo them
# TODO add easy ability to skip check
"$HERE"/is-git-clean || exit 1

HOST=${1:-pi}
TARGET_HOST=${2:-$HOST} # allow setting an IP if dns access does not work yet, e.g. for a new pi

nixos-rebuild \
    switch \
    --option extra-experimental-features "nix-command flakes pipe-operator" \
    --fast \
    --flake .#"$HOST" \
    --target-host "$TARGET_HOST" \
    --use-remote-sudo \
    --log-format internal-json -v 2>&1 |
    nom --json
